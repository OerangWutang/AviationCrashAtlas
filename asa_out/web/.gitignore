# next-env.d.ts is intentionally NOT ignored.
# It is a thin reference shim regenerated by Next.js, but committing it
# ensures `tsc --noEmit` (our type-check CI step) succeeds on a fresh
# checkout without requiring a prior `next dev` / `next build`.
# See https://nextjs.org/docs/app/building-your-application/configuring/typescript
.env.local
