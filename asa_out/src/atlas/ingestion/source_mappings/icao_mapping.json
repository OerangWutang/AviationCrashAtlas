{
  "_comment": [
    "ICAO accident/incident data mapping.",
    "",
    "ICAO publishes annual accident statistics in CSV format via the ICAO Safety Report.",
    "Download from: https://www.icao.int/safety/iStars/Pages/Accident-Statistics.aspx",
    "",
    "Column names may vary by year; adjust field_map if the export format changes.",
    "record_id_field should be the unique accident reference number if present."
  ],
  "source_id": "src-icao-001",
  "record_id_field": "Accident_ID",
  "delimiter": ",",
  "encoding": "utf-8",
  "field_map": {
    "Date":                  "occurred_at",
    "State":                 "country_code",
    "Location":              "location_text",
    "Aircraft_Type":         "aircraft_make",
    "Registration":          "aircraft_registration",
    "Operator":              "operator_name",
    "Phase_of_Flight":       "phase_of_flight",
    "Fatalities":            "fatalities_total",
    "Severity":              "injury_severity",
    "Aircraft_Damage":       "aircraft_damage",
    "Narrative":             "probable_cause",
    "Weather":               "weather_condition",
    "Investigation_Status":  "investigation_status"
  },
  "value_transforms": {
    "injury_severity": {
      "fatal":        "FATAL",
      "Fatal":        "FATAL",
      "serious":      "SERIOUS",
      "Serious":      "SERIOUS",
      "minor":        "MINOR",
      "Minor":        "MINOR",
      "none":         "NONE",
      "None":         "NONE"
    },
    "aircraft_damage": {
      "destroyed":    "DESTROYED",
      "Destroyed":    "DESTROYED",
      "substantial":  "SUBSTANTIAL",
      "Substantial":  "SUBSTANTIAL",
      "minor":        "MINOR",
      "Minor":        "MINOR",
      "none":         "NONE",
      "None":         "NONE"
    }
  }
}
