{
  "name": "atlas-bff",
  "version": "0.1.0",
  "description": "Browser-safe Backend-for-Frontend for Atlas. Owns human sessions, CSRF, and server-side Atlas API-key bridging.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --experimental-sqlite --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "migrate": "node --input-type=module -e \"import('./src/db/migrate.js').then(m => m.runMigrations())\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "argon2": "^0.41.1",
    "fastify": "^5.3.2",
    "ioredis": "^5.4.0",
    "nanoid": "^5.1.5",
    "pg": "^8.21.0",
    "undici": "^7.10.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.20.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
